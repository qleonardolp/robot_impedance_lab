<sdf version='1.10'>
  <world name='Waterworld'>
    <physics name='default_physics' type='dart'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::ForceTorque' filename='gz-sim-forcetorque-system'/>
    <plugin name='gz::sim::systems::Buoyancy' filename='gz-sim-buoyancy-system'>
      <uniform_fluid_density>1027</uniform_fluid_density>
    </plugin>
    <magnetic_field>1.83535e-05 -7.7993e-06 -1.46974e-05</magnetic_field>
    <gravity>0.0 0.00 -9.80665</gravity>
    <atmosphere type='adiabatic'/>
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Coast Water
      </uri>
    </include>
    <scene>
      <ambient>0.40 0.40 0.40 1</ambient>
      <background>0.70 0.69 0.69 1</background>
      <shadows>false</shadows>
    </scene>
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.800000012 0.800000012 0.800000012 1</ambient>
            <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
            <specular>0.800000012 0.800000012 0.800000012 1</specular>
          </material>
        </visual>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <self_collide>false</self_collide>
      <pose>0 0 -25.0 0 0 0</pose>
    </model>
    <model name='support'>
      <pose>0.6 0.0 -24.8 0 0 0</pose>
      <link name='support_link'>
        <inertial auto='true'/>
        <collision name='support_collision'>
          <density>2600.0</density>
          <geometry>
            <box>
              <size>0.70 1.40 0.40</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.4</mu>
                <mu2>0.4</mu2>
              </ode>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='support_visual'>
          <geometry>
            <box>
              <size>0.70 1.40 0.40</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 1.0 1.0 1.0</ambient>
            <diffuse>0.20 1.0 1.0 0.80</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
      </link>
      <static>true</static>
    </model>
    <model name='pipe'>
      <pose>0.78 0.45 -24.3 0 0 0</pose>
      <link name='pipe_link'>
        <inertial auto='true'/>
        <collision name='pipe_collision'>
          <density>7980.0</density> <!-- stainless steel 316l -->
          <geometry>
            <cylinder>
              <radius>0.050</radius>
              <length>0.600</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='pipe_visual'>
          <geometry>
            <cylinder>
              <radius>0.050</radius>
              <length>0.600</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.80 0 0.40 1.0</ambient>
            <diffuse>0.80 0 0.40 0.88</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <enable_wind>false</enable_wind>
      </link>
      <static>false</static>
    </model>
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0.5 0.10 -0.90</direction>
      <diffuse>0.80 0.80 0.80 1</diffuse>
      <specular>0.200 0.200 0.200 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.900</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
  </world>
</sdf>
